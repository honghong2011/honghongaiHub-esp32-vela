<template>
  <div class="page" @swipe="onSwipe">
    <!-- 顶部标题 -->
    <div class="header">
      <div class="back-btn" @click="goBack">
        <text class="back-icon">‹</text>
      </div>
      <text class="header-title">{{view === 'list' ? '选择 WiFi' : '设置'}}</text>
    </div>

    <!-- ========= 列表视图：扫描结果 ========= -->
    <div class="scan-body" show="{{view === 'list'}}">
      <div class="scan-tip" show="{{scanning}}">
        <text class="scan-tip-text">正在扫描附近 WiFi…</text>
      </div>
      <list class="ap-list" show="{{!scanning}}">
        <list-item type="ap" class="ap-item" for="{{wifiAps}}">
          <div class="ap-row" @click="pickAp($item.ssid)">
            <text class="ap-ssid">{{$item.ssid}}</text>
            <text class="ap-rssi">{{$item.rssi}} dBm</text>
          </div>
        </list-item>
        <!-- 扫描结果为空 -->
        <list-item type="apempty" class="ap-item" show="{{wifiAps.length === 0}}">
          <div class="ap-row">
            <text class="ap-ssid ap-dim">未扫描到网络，点此重试</text>
          </div>
        </list-item>
        <!-- 手动输入兜底（隐藏网络等场景） -->
        <list-item type="apmanual" class="ap-item">
          <div class="ap-row" @click="manualSsid">
            <text class="ap-ssid ap-dim">手动输入 SSID</text>
          </div>
        </list-item>
      </list>
    </div>

    <!-- ========= 表单视图：状态 + 手动输入 + 扫描入口 ========= -->
    <div class="card" show="{{view === 'form'}}">
      <text class="card-title">WiFi 配置</text>
      <text class="card-status">状态: {{wifiLabel}}</text>
      <text class="card-ip" show="{{wifiIp}}">IP: {{wifiIp}}</text>

      <!-- 扫描入口（主推流程） -->
      <div class="btn-scan" @click="openScan">
        <text class="btn-scan-text">扫描附近 WiFi</text>
      </div>

      <!-- 手动输入（备用） -->
      <div class="field" @click="startEditSsid">
        <text class="field-label">SSID:</text>
        <text class="field-value">{{ssid || '点击输入'}}</text>
      </div>
      <div class="field" @click="startEditPass">
        <text class="field-label">密码:</text>
        <text class="field-value">{{pass || '点击输入'}}</text>
      </div>

      <div class="btn-row">
        <div class="btn-conn" @click="doConnectWifi">
          <text class="btn-conn-text">{{wifiState === 'connecting' ? '连接中…' : '连接'}}</text>
        </div>
      </div>
    </div>

    <!-- 蓝牙卡片 -->
    <div class="card" show="{{view === 'form'}}">
      <text class="card-title">蓝牙桥接</text>
      <text class="card-status">状态: {{btLabel}}</text>
      <div class="btn-row">
        <div class="btn-conn" @click="doBtReconnect">
          <text class="btn-conn-text">重新连接</text>
        </div>
      </div>
    </div>

    <!-- Web 配置端 -->
    <div class="card" show="{{view === 'form'}}">
      <text class="card-title">Web 配置端</text>
      <text class="card-status" show="{{espIp}}">http://{{espIp}}/</text>
      <text class="card-status" show="{{!webHint}}">在电脑上管理 AI 供应商（期间蓝牙暂断）</text>
      <text class="card-status web-hint" show="{{webHint}}">{{webHint}}</text>
      <div class="btn-row">
        <div class="btn-conn btn-web" @click="doOpenWeb">
          <text class="btn-conn-text">打开 Web 端</text>
        </div>
      </div>
    </div>

    <!-- 关于 -->
    <div class="card" show="{{view === 'form'}}">
      <text class="card-title">关于</text>
      <text class="card-status">宏宏AIHub v1.2</text>
    </div>
  </div>
</template>

<style>
.page {
  width: 336px;
  height: 480px;
  flex-direction: column;
  background-color: #000000;
}

.header {
  width: 336px;
  height: 44px;
  flex-direction: row;
  align-items: center;
  padding-left: 8px;
  background-color: #111111;
}

.back-btn {
  width: 32px;
  height: 32px;
  border-radius: 16px;
  background-color: #2C2C2E;
  justify-content: center;
  align-items: center;
  margin-right: 8px;
}

.back-icon {
  font-size: 24px;
  color: #ffffff;
}

.header-title {
  font-size: 24px;
  font-weight: bold;
  color: #33B4FF;
}

/* ---- 列表视图 ---- */
.scan-body {
  flex: 1;
  width: 336px;
  flex-direction: column;
}

.scan-tip {
  width: 336px;
  padding: 20px 0;
  justify-content: center;
  align-items: center;
}

.scan-tip-text {
  font-size: 20px;
  color: #888888;
}

.ap-list {
  flex: 1;
  width: 336px;
}

.ap-item {
  padding: 3px 12px;
}

.ap-row {
  width: 312px;
  height: 52px;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  background-color: #1C1C1E;
  border-radius: 12px;
  padding-left: 16px;
  padding-right: 16px;
}

.ap-ssid {
  font-size: 20px;
  color: #ffffff;
  flex: 1;
  lines: 1;
  text-overflow: ellipsis;
}

.ap-dim {
  color: #888888;
}

.ap-rssi {
  font-size: 16px;
  color: #666666;
  margin-left: 8px;
}

/* ---- 表单视图 ---- */
.card {
  width: 312px;
  border-radius: 16px;
  background-color: #1C1C1E;
  flex-direction: column;
  padding: 8px 16px;
  margin: 6px 12px 0 12px;
}

.card-title {
  font-size: 20px;
  font-weight: bold;
  color: #ffffff;
}

.card-status {
  font-size: 16px;
  color: #888888;
  margin-top: 2px;
}

.card-ip {
  font-size: 16px;
  color: #33B4FF;
  margin-top: 2px;
}

.btn-scan {
  width: 280px;
  height: 44px;
  border-radius: 22px;
  background-color: #16567d;
  justify-content: center;
  align-items: center;
  margin-top: 8px;
}

.btn-scan-text {
  font-size: 20px;
  font-weight: bold;
  color: #ffffff;
}

.field {
  width: 280px;
  height: 32px;
  flex-direction: row;
  align-items: center;
  background-color: #2C2C2E;
  border-radius: 12px;
  padding-left: 12px;
  margin-top: 6px;
}

.field-label {
  font-size: 16px;
  color: #888888;
  margin-right: 8px;
}

.field-value {
  font-size: 16px;
  color: #ffffff;
  flex: 1;
  lines: 1;
  text-overflow: ellipsis;
}

.btn-row {
  flex-direction: row;
  justify-content: flex-end;
  margin-top: 6px;
}

.btn-conn {
  width: 100px;
  height: 32px;
  border-radius: 16px;
  background-color: #33B4FF;
  justify-content: center;
  align-items: center;
}

.btn-web {
  background-color: #4CAF50;
}

.web-hint {
  color: #FFA726;
}

.btn-conn-text {
  font-size: 16px;
  font-weight: bold;
  color: #000000;
}
</style>

<script>
import router from '@system.router'
import prompt from '@system.prompt'
import {
  initBridge, isLinkReady, checkLink, on, off, send
} from '../../common/bridge'
import { saveEspIp, loadEspIp } from '../../common/store'

export default {
  private: {
    view: 'form',           // form（表单）| list（扫描列表）
    scanning: false,
    wifiAps: [],            // 扫描结果 [{ssid, rssi}]
    selectedSsid: '',       // 列表选中的网络（输密码时用）
    ssid: '',
    pass: '',
    wifiState: 'unknown',   // connecting / connected / failed / unknown
    wifiIp: '',
    btLabel: '未知',
    espIp: '',
    webHint: ''             // Web 模式提示（发送后临时显示）
  },

  onInit() {
    initBridge()
    this._onWifi = (payload) => { this.onWifiStatus(payload) }
    this._onList = (payload) => { this.onWifiList(payload) }
    on('wifi_status', this._onWifi)
    on('wifi_list', this._onList)
    loadEspIp((ip) => { this.espIp = ip })
    // 拉取当前 WiFi 状态
    setTimeout(() => { send('wifi_query', {}) }, 500)
    setTimeout(() => { checkLink() }, 300)
  },

  onDestroy() {
    off('wifi_status', this._onWifi)
    off('wifi_list', this._onList)
  },

  onShow() {
    // 键盘页返回：按 target 消费结果
    const result = globalThis.__kbResult
    if (!result) return
    globalThis.__kbResult = null

    if (result.target === 'pass' && this.selectedSsid) {
      // 扫描流程最后一步：选中的 SSID + 输入的密码一起发给 ESP32
      const ssid = this.selectedSsid
      this.selectedSsid = ''
      this.view = 'form'
      this.wifiState = 'connecting'
      const ok = send('wifi_set', { ssid: ssid, pass: result.text })
      if (!ok) this.wifiState = 'failed'
      return
    }
    if (result.target === 'ssid') {
      // 手动输入 SSID（备用流程）
      this.ssid = result.text
      return
    }
    if (result.target === 'passmanual') {
      // 手动流程：SSID 字段已有，补密码后发送
      this.pass = result.text
      if (this.ssid) {
        this.wifiState = 'connecting'
        const ok = send('wifi_set', { ssid: this.ssid, pass: this.pass })
        if (!ok) this.wifiState = 'failed'
      }
    }
  },

  onWifiStatus(payload) {
    this.wifiState = payload.state || 'unknown'
    this.wifiIp = payload.ip || ''
    if (payload.ip) {
      this.espIp = payload.ip
      saveEspIp(payload.ip)
    }
  },

  onWifiList(payload) {
    this.wifiAps = payload.aps || []
    this.scanning = false
  },

  // ---------- 扫描流程 ----------
  openScan() {
    this.view = 'list'
    this.scanning = true
    this.wifiAps = []
    // 12s 未收到结果提示重试（顺序射频：ESP32 需拆蓝牙→扫描→重连→推送，
    // 全程 10~20 秒；wifi_list 到达时 scanning 置 false）
    const self = this
    setTimeout(() => {
      if (self.scanning) {
        self.scanning = false
        if (self.wifiAps.length === 0) {
          try { prompt.showToast({ message: '扫描超时，点列表重试' }) } catch (e) {}
        }
      }
    }, 12000)
    send('wifi_scan', {})
  },

  pickAp(ssid) {
    if (this.scanning) return
    this.selectedSsid = ssid
    globalThis.__kbTarget = 'pass'
    globalThis.__kbResult = null
    router.push({
      uri: 'pages/keyboard',
      params: { target: 'pass', title: ssid, value: '', maxlen: '64' }
    })
  },

  // ---------- 手动流程（备用） ----------
  manualSsid() {
    globalThis.__kbTarget = 'ssid'
    globalThis.__kbResult = null
    router.push({
      uri: 'pages/keyboard',
      params: { target: 'ssid', title: '手动输入 SSID', value: this.ssid, maxlen: '32' }
    })
    // 返回后 onShow 填 ssid，用户再点密码字段（target passmanual）
    // 简化：手动流程密码也走键盘页
    this._manualPending = true
  },

  startEditSsid() {
    globalThis.__kbTarget = 'ssid'
    globalThis.__kbResult = null
    router.push({
      uri: 'pages/keyboard',
      params: { target: 'ssid', title: 'WiFi 名称', value: this.ssid, maxlen: '32' }
    })
  },

  startEditPass() {
    globalThis.__kbTarget = 'passmanual'
    globalThis.__kbResult = null
    router.push({
      uri: 'pages/keyboard',
      params: { target: 'passmanual', title: 'WiFi 密码', value: this.pass, maxlen: '64' }
    })
  },

  doConnectWifi() {
    if (!this.ssid) return
    if (this.wifiState === 'connecting') return
    const ok = send('wifi_set', { ssid: this.ssid, pass: this.pass })
    if (ok) {
      this.wifiState = 'connecting'
    }
  },

  // ---------- Web 配置端 ----------
  // 发送 web_open：ESP32 拆蓝牙 → 连 WiFi（失败开热点 HHAIHub）→ Web 常驻
  // 用户在电脑改完配置点网页「推送到手环」→ ESP32 重连蓝牙自动补推
  doOpenWeb() {
    this.webHint = '切换中…约20秒后电脑可访问'
    const ok = send('web_open', {})
    if (ok) {
      setTimeout(() => {
        this.webHint = '请访问上方地址；连不上时请连接设备热点 HHAIHub（192.168.4.1）'
      }, 20000)
    } else {
      this.webHint = '发送失败，请检查蓝牙连接'
    }
  },

  // ---------- 蓝牙 ----------
  doBtReconnect() {
    checkLink()
    setTimeout(() => { send('watch_hello', { from: 'watch', page: 'setting' }) }, 300)
    this.btLabel = isLinkReady() ? '已连接' : '重连中'
  },

  goBack() {
    if (this.view === 'list') {
      this.view = 'form'   // 列表视图返回先回表单
      return
    }
    router.back()
  },

  // 右滑返回（根元素 @swipe）
  onSwipe(e) {
    if (e.direction === 'right') this.goBack()
  }
}
</script>
