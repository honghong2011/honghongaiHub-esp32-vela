<template>
  <div class="page" @swipe="onSwipe">
    <!-- 顶部标题 -->
    <div class="header">
      <div class="back-btn" @click="goBack">
        <text class="back-icon">‹</text>
      </div>
      <text class="header-title">设置</text>
    </div>

    <!-- ========= 表单视图：状态 + 手动输入 + 扫描入口 ========= -->
    <div class="card" show="{{view === 'form'}}">
      <text class="card-title">WiFi 配置</text>
      <text class="card-status">状态: {{wifiState}}</text>
      <text class="card-ip" show="{{wifiIp}}">IP: {{wifiIp}}</text>

      <!-- 扫描入口（主推流程） -->
      <div class="btn-scan" @click="openScan">
        <text class="btn-scan-text">扫描附近 WiFi</text>
      </div>

      <!-- 手动输入（备用） -->
      <div class="field" @click="startEditSsid">
        <text class="field-label">SSID:</text>
        <text class="field-value">{{ssid || '点击输入'}}</text>
      </div>
      <div class="field" @click="startEditPass">
        <text class="field-label">密码:</text>
        <text class="field-value">{{pass || '点击输入'}}</text>
      </div>

      <div class="btn-row">
        <div class="btn-conn" @click="doConnectWifi">
          <text class="btn-conn-text">{{wifiState === 'connecting' ? '连接中…' : '连接'}}</text>
        </div>
      </div>
    </div>

    <!-- 蓝牙卡片 -->
    <div class="card" show="{{view === 'form'}}">
      <text class="card-title">蓝牙桥接</text>
      <text class="card-status">状态: {{btLabel}}</text>
      <div class="btn-row">
        <div class="btn-conn" @click="doBtReconnect">
          <text class="btn-conn-text">重新连接</text>
        </div>
      </div>
    </div>

    <!-- Web 配置端 -->
    <div class="card" show="{{view === 'form'}}">
      <text class="card-title">Web 配置端</text>
      <text class="card-status" show="{{espIp}}">http://{{espIp}}/</text>
      <text class="card-status" show="{{!webHint}}">在电脑上管理 AI 供应商（期间蓝牙暂断）</text>
      <text class="card-status web-hint" show="{{webHint}}">{{webHint}}</text>
      <div class="btn-row">
        <div class="btn-conn btn-web" @click="doOpenWeb">
          <text class="btn-conn-text">打开 Web 端</text>
        </div>
      </div>
    </div>

    <!-- 关于 -->
    <div class="card" show="{{view === 'form'}}">
      <text class="card-title">关于</text>
      <text class="card-status">宏宏AIHub v1.3</text>
    </div>
  </div>
</template>

<style>
.page {
  width: 336px;
  height: 480px;
  flex-direction: column;
  background-color: #000000;
}

.header {
  width: 336px;
  height: 44px;
  flex-direction: row;
  align-items: center;
  padding-left: 8px;
  background-color: #111111;
}

.back-btn {
  width: 32px;
  height: 32px;
  border-radius: 16px;
  background-color: #2C2C2E;
  justify-content: center;
  align-items: center;
  margin-right: 8px;
}

.back-icon {
  font-size: 24px;
  color: #ffffff;
}

.header-title {
  font-size: 24px;
  font-weight: bold;
  color: #33B4FF;
}

/* ---- 表单视图 ---- */
.card {
  width: 312px;
  border-radius: 16px;
  background-color: #1C1C1E;
  flex-direction: column;
  padding: 8px 16px;
  margin: 6px 12px 0 12px;
}

.card-title {
  font-size: 20px;
  font-weight: bold;
  color: #ffffff;
}

.card-status {
  font-size: 16px;
  color: #888888;
  margin-top: 2px;
}

.card-ip {
  font-size: 16px;
  color: #33B4FF;
  margin-top: 2px;
}

.btn-scan {
  width: 280px;
  height: 44px;
  border-radius: 22px;
  background-color: #16567d;
  justify-content: center;
  align-items: center;
  margin-top: 8px;
}

.btn-scan-text {
  font-size: 20px;
  font-weight: bold;
  color: #ffffff;
}

.field {
  width: 280px;
  height: 32px;
  flex-direction: row;
  align-items: center;
  background-color: #2C2C2E;
  border-radius: 12px;
  padding-left: 12px;
  margin-top: 6px;
}

.field-label {
  font-size: 16px;
  color: #888888;
  margin-right: 8px;
}

.field-value {
  font-size: 16px;
  color: #ffffff;
  flex: 1;
  lines: 1;
  text-overflow: ellipsis;
}

.btn-row {
  flex-direction: row;
  justify-content: flex-end;
  margin-top: 6px;
}

.btn-conn {
  width: 100px;
  height: 32px;
  border-radius: 16px;
  background-color: #33B4FF;
  justify-content: center;
  align-items: center;
}

.btn-web {
  background-color: #4CAF50;
}

.web-hint {
  color: #FFA726;
}

.btn-conn-text {
  font-size: 16px;
  font-weight: bold;
  color: #000000;
}
</style>

<script>
import router from '@system.router'
import {
  initBridge, isLinkReady, checkLink, on, off, send
} from '../../common/bridge'
import { saveEspIp, loadEspIp } from '../../common/store'

export default {
  private: {
    view: 'form',           // 表单视图常驻（扫描列表已拆到独立页 pages/wifilist）
    ssid: '',
    pass: '',
    wifiState: 'unknown',   // connecting / connected / failed / unknown
    wifiIp: '',
    btLabel: '未知',
    espIp: '',
    webHint: ''             // Web 模式提示（发送后临时显示）
  },

  onInit() {
    initBridge()
    this._onWifi = (payload) => { this.onWifiStatus(payload) }
    on('wifi_status', this._onWifi)
    loadEspIp((ip) => { this.espIp = ip })
    // 拉取当前 WiFi 状态
    setTimeout(() => { send('wifi_query', {}) }, 500)
    setTimeout(() => { checkLink() }, 300)
  },

  onDestroy() {
    off('wifi_status', this._onWifi)
  },

  onShow() {
    // 键盘页返回：按 target 消费结果
    const result = globalThis.__kbResult
    if (!result) return
    globalThis.__kbResult = null

    if (result.target === 'ssid') {
      // 手动输入 SSID（备用流程）
      this.ssid = result.text
      return
    }
    if (result.target === 'passmanual') {
      // 手动流程：SSID 字段已有，补密码后发送
      this.pass = result.text
      if (this.ssid) {
        this.wifiState = 'connecting'
        const ok = send('wifi_set', { ssid: this.ssid, pass: this.pass })
        if (!ok) this.wifiState = 'failed'
      }
    }
  },

  onWifiStatus(payload) {
    this.wifiState = payload.state || 'unknown'
    this.wifiIp = payload.ip || ''
    if (payload.ip) {
      this.espIp = payload.ip
      saveEspIp(payload.ip)
    }
  },

  // ---------- 扫描流程 ----------
  // 扫描列表拆到独立页 pages/wifilist：设置页内嵌视图翻转 + scroll 的
  // 组合在本机实测整块不渲染（黑屏根因），独立页 scroll 从创建起常驻
  openScan() {
    router.push({ uri: 'pages/wifilist' })
  },

  // ---------- 手动流程（备用兜底） ----------
  startEditSsid() {
    globalThis.__kbTarget = 'ssid'
    globalThis.__kbResult = null
    router.push({
      uri: 'pages/keyboard',
      params: { target: 'ssid', title: 'WiFi 名称', value: this.ssid, maxlen: '32' }
    })
  },

  startEditPass() {
    globalThis.__kbTarget = 'passmanual'
    globalThis.__kbResult = null
    router.push({
      uri: 'pages/keyboard',
      params: { target: 'passmanual', title: 'WiFi 密码', value: this.pass, maxlen: '64' }
    })
  },

  doConnectWifi() {
    if (!this.ssid) return
    if (this.wifiState === 'connecting') return
    const ok = send('wifi_set', { ssid: this.ssid, pass: this.pass })
    if (ok) {
      this.wifiState = 'connecting'
    }
  },

  // ---------- Web 配置端 ----------
  // 发送 web_open：ESP32 拆蓝牙 → 连 WiFi（失败开热点 HHAIHub）→ Web 常驻
  // 用户在电脑改完配置点网页「推送到手环」→ ESP32 重连蓝牙自动补推
  doOpenWeb() {
    this.webHint = '切换中…约20秒后电脑可访问'
    const ok = send('web_open', {})
    if (ok) {
      setTimeout(() => {
        this.webHint = '请访问上方地址；连不上时请连接设备热点 HHAIHub（192.168.4.1）'
      }, 20000)
    } else {
      this.webHint = '发送失败，请检查蓝牙连接'
    }
  },

  // ---------- 蓝牙 ----------
  doBtReconnect() {
    checkLink()
    setTimeout(() => { send('watch_hello', { from: 'watch', page: 'setting' }) }, 300)
    this.btLabel = isLinkReady() ? '已连接' : '重连中'
  },

  goBack() {
    router.back()
  },

  // 右滑返回（根元素 @swipe）
  onSwipe(e) {
    if (e.direction === 'right') this.goBack()
  }
}
</script>
