<template>
  <div class="page" @swipe="onSwipe">
    <!-- 链路调试页：原 echo demo 保留，用于链路问题定位 -->
    <div class="topbar">
      <div class="back-btn" @click="goBack">
        <text class="back-icon">‹</text>
      </div>
      <text class="app-name">链路调试</text>
    </div>
    <text class="status">{{statusText}}</text>

    <!-- 收发统计 -->
    <div class="stat-row">
      <text class="stat-label">收到</text>
      <text class="stat-val">{{rxCount}}</text>
      <text class="stat-label">发成功</text>
      <text class="stat-val">{{txOk}}</text>
      <text class="stat-label">发失败</text>
      <text class="stat-val stat-bad">{{txFail}}</text>
    </div>
    <text class="err-line">{{lastErr}}</text>

    <div class="card">
      <text class="card-label">最近收到</text>
      <text class="card-val">{{lastRx}}</text>
    </div>
    <div class="card">
      <text class="card-label">最近发送</text>
      <text class="card-val">{{lastTx}}</text>
    </div>

    <div class="btn-main" @click="sendTest">
      <text class="btn-main-text">发送测试</text>
    </div>
    <div class="btn-sub" @click="checkState">
      <text class="btn-sub-text">连接自检</text>
    </div>
  </div>
</template>

<style>
.page {
  width: 336px;
  height: 480px;
  flex-direction: column;
  align-items: center;
  background-color: #000000;
  padding-top: 8px;
}

