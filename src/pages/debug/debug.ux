  width: 32px;
  height: 32px;
  border-radius: 16px;
  background-color: #2C2C2E;
  justify-content: center;
  align-items: center;
  margin-right: 12px;
}

.back-icon {
  font-size: 24px;
  color: #ffffff;
}

.app-name {
  font-size: 30px;
  font-weight: bold;
  color: #33B4FF;
}

.status {
  font-size: 18px;
  color: #888888;
  margin-top: 4px;
}

.stat-row {
  flex-direction: row;
  align-items: center;
  margin-top: 6px;
}

.stat-label {
  font-size: 18px;
  color: #888888;
}

.stat-val {
  font-size: 20px;
  color: #33B4FF;
  margin-left: 4px;
  margin-right: 12px;
}

.stat-bad {
  color: #FF6B6B;
}

.err-line {
  font-size: 16px;
  color: #FF6B6B;
  margin-top: 2px;
  min-height: 20px;
}

.card {
  width: 300px;
  min-height: 60px;
  border-radius: 16px;
  background-color: #1C1C1E;
  flex-direction: column;
  align-items: flex-start;
  padding: 6px 16px;
  margin-top: 8px;
}

.card-label {
  font-size: 16px;
  color: #888888;
}

.card-val {
  font-size: 18px;
  color: #ffffff;
  margin-top: 2px;
}

.btn-main {
  width: 236px;
  height: 60px;
  border-radius: 30px;
  background-color: #33B4FF;
  justify-content: center;
  align-items: center;
  margin-top: 16px;
}

.btn-main-text {
  font-size: 26px;
  font-weight: bold;
  color: #000000;
}

.btn-sub {
  width: 236px;
  height: 52px;
  border-radius: 26px;
  background-color: #2C2C2E;
  justify-content: center;
  align-items: center;
  margin-top: 10px;
}

.btn-sub-text {
  font-size: 22px;
  color: #ffffff;
}
</style>

<script>
// 链路调试页：发送仍直连 interconnect 原始实例（保留 1006/202/204 分类
// 与热身重试），收包显示改为挂 bridge.js 的分身（setRawTap）。
// 旧版本页会抢占单例的 onmessage：抢占期间 providers_push / wifi_ap_push
// 等帧被本页整包丢弃（只展示不处理），业务表现为"链路通但推送不吃"。
import interconnect from '@system.interconnect'
import router from '@system.router'
import {
  initBridge, setRawTap, onLinkState, offLinkState, isLinkReady
} from '../../common/bridge'

export default {
  private: {
    status: '初始化',
    lastRx: '-',
    lastTx: '-',
    lastErr: '',
    rxCount: 0,
    txOk: 0,
    txFail: 0,
    sendMode: '',
    linkReady: false
  },

  computed: {
    statusText() {
      return '链路: ' + this.status
    }
  },

  onInit() {
    this.connect = interconnect.instance()
    initBridge()          // 确保 bridge 统一处理器在场（不抢 onmessage）
    this._tap = (text) => {
      let t = text
      if (typeof t !== 'string') {
        try { t = JSON.stringify(t) } catch (e) { t = String(t) }
      }
      this.rxCount += 1
      this.lastRx = this.truncate(t)
      console.log('RX: ' + t)
    }
    setRawTap(this._tap)
    this._onLink = (ready) => {
      this.linkReady = ready
      this.status = ready ? '已连接' : '蓝牙未连接'
    }
    onLinkState(this._onLink)
    this.linkReady = isLinkReady()
    this.status = this.linkReady ? '已连接' : '等待中'
    this.checkState()
    setTimeout(() => {
      this.sendMsg('watch_hello', { from: 'watch', page: 'debug' })
    }, 500)
  },

  onDestroy() {
    setRawTap(null)
    offLinkState(this._onLink)
    initBridge()    // 兜底恢复统一处理器
  },

  sendMsg(type, payload) {
    this.sendRaw(JSON.stringify({
      v: 3, id: 'w' + Date.now(), timestamp: Date.now(),
      type: type, payload: payload
    }))
  },

  sendRaw(text) {
    this.lastTx = this.truncate(text)
    if (!this.connect) {
      this.txFail += 1
      this.lastErr = 'no connect instance'
      return
    }
    if (!this.linkReady) {
      this.txFail += 1
      this.lastErr = '蓝牙未连接，ESP32重连中，请稍候'
      this.status = '蓝牙未连接'
      this.checkState()
      return
    }
    const mode = this.sendMode || 'obj'
    this.trySend(text, mode, (ok) => {
      if (ok) return
      if (!this.linkReady) return
      if (this.sendMode) {
        this.checkState()
        setTimeout(() => {
          if (this.linkReady) this.trySend(text, mode, () => {})
        }, 800)
        return
      }
      const alt = mode === 'obj' ? 'str' : 'obj'
      this.trySend(text, alt, (ok2) => {
        if (ok2) this.sendMode = alt
      })
    })
  },

  trySend(text, mode, done) {
    const payload = mode === 'str' ? text : { json: text }
    this.connect.send({
      data: payload,
      success: () => {
        this.txOk += 1
        this.lastErr = ''
        this.linkReady = true
        this.status = '已连接'
        if (!this.sendMode) this.sendMode = mode
        done(true)
      },
      fail: (data, code) => {
        this.txFail += 1
        if (code === 1006) {
          this.linkReady = false
          this.lastErr = '蓝牙断开(code 1006)，ESP32重连中'
          this.status = '蓝牙未连接'
          done(false)
          return
        }
        this.lastErr = 'send失败[' + mode + '] code=' + code + ' ' +
                       (data && data.data ? data.data : '')
        done(false)
      }
    })
  },

  sendTest() {
    this.sendMsg('echo_test', { msg: 'hello from watch', time: Date.now() })
  },

  checkState() {
    this.connect.getReadyState({
      success: (data) => {
        this.linkReady = (data.status === 1)
        const s = data.status === 1 ? '已连接' : (data.status === 2 ? '蓝牙未连接' : '未知' + data.status)
        this.status = s
      },
      fail: () => { this.status = '查询失败' }
    })
  },

  goBack() {
    router.back()
  },

  // 右滑返回（根元素 @swipe）
  onSwipe(e) {
    if (e.direction === 'right') router.back()
  },

  truncate(text) {
    if (!text) return '-'
    return text.length > 60 ? text.substring(0, 60) + '...' : text
  }
}
</script>
